---
import Layout from "../layouts/Layout.astro";
import OnePager from "../components/OnePager.astro";
import ContactUs from "../components/ContactUs.svelte";

const emailTo = import.meta.env.EMAIL_TO;
---

<Layout
  title="Telos-S for Reinsurers"
  canonicalUrl="https://telosgenomics.bio/reinsurers"
  minimal
  excerpt="Variant-level structural risk signal for pandemic loss exposure monitoring. Registry-recorded decisions, symmetric benchmarks, exploratory status disclosed."
  tags="reinsurance, pandemic risk, genomic surveillance, Telos-S"
>
  <OnePager
    eyebrow="For life & health reinsurers"
    title="A structural risk signal for pandemic loss exposure."
    lede="Variant-level structural risk quantified from primary sequence once its FASTA is available — an input for exposure monitoring, not a loss predictor. Selected analysis-linked decisions and their evidence can be recorded in a hash-linked registry before outcomes are observed; comparisons follow a published protocol."
    deliverables={[
      {
        title: "Scores from primary sequence",
        text: "In a documented retrospective case, XFG.5.1.7 was scored 2280.5 five days after its GenBank release, before lineage characterization caught up — primary-sequence risk assessment inside the classification blind window.",
      },
      {
        title: "Traceable, registry-recorded decisions",
        text: "A prospective registry can record selected analysis-linked decisions with a server-generated UTC timestamp, a configuration hash and an evidence snapshot before outcomes are observed. The hash chain provides tamper-evidence for recorded entries; it does not by itself prevent excluding entries before recording, editing and recalculating the chain, or selecting which sequences to analyze.",
      },
      {
        title: "Symmetric benchmarks",
        text: "Same isolates, same outcomes and a shared rank metric against reference models (supervised fitness and immune-escape) — results reported under a published protocol, including negative deltas where observed.",
      },
      {
        title: "Frozen demo analyses",
        text: "JN.1, KP.3.1.1 and XBB.1.5 packs with full provenance (accession, job, config hash, integrity manifest), explorable without our infrastructure.",
      },
    ]}
    honesty={[
      "No validated lead-time claim: any weeks-of-anticipation figure is the hypothesis under test, not a result.",
      "Scores proxy structural destabilization — not hospitalization, mortality, or claims.",
      "Pipeline constants are heuristic; geospatial projections are exploratory and excluded from validation.",
    ]}
    pilotIntro="Four weeks against your own timelines: our scores, your excess-mortality and claims data, your definitions."
    pilot={[
      {
        week: "W1",
        title: "Historical panel",
        text: "We score an agreed set of historical variants; you hold the outcome timelines.",
      },
      {
        week: "W2",
        title: "Joint analysis",
        text: "Score trajectories versus your excess-mortality and claims data — computed together, with your outcome definitions.",
      },
      {
        week: "W3",
        title: "Prospective watchlist",
        text: "Newly available sequences scored as you provide them; selected decisions recorded in the registry before outcomes are known.",
      },
      {
        week: "W4",
        title: "Readout",
        text: "Rank correlation, hits and misses, and a decision on a recurring exposure watchlist.",
      },
    ]}
    resourcesNote="Publication (Zenodo DOI 10.5281/zenodo.21381359) · software under MIT (telos-s-backend, telos-s-frontend, telos-s-deploy). Frozen demo analyses available on request."
  />
  <ContactUs client:load emailTo={emailTo} initialSector="Reinsurance / Insurance" />
</Layout>
