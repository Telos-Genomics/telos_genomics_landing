---
// Shared one-pager layout for buyer pages (B5): labs, reinsurers, airlines.
// Static component (no client JS). Honesty is structural: every page MUST
// pass an `honesty` list stating what Telos-S does NOT claim; the paper
// reports retrospective consistency, not prospective predictive validation.
interface Deliverable {
  title: string;
  text: string;
}
interface PilotWeek {
  week: string;
  title: string;
  text: string;
}
interface Props {
  eyebrow: string;
  title: string;
  lede: string;
  deliverables: Deliverable[];
  honesty: string[];
  pilotIntro: string;
  pilot: PilotWeek[];
  resourcesNote?: string;
}
const { eyebrow, title, lede, deliverables, honesty, pilotIntro, pilot, resourcesNote } =
  Astro.props;
---

<section class="relative bg-[#f5f3ee] px-6 md:px-24 pt-32 pb-20 overflow-hidden">
  <div
    class="absolute inset-0 pointer-events-none"
    style="background-image: linear-gradient(rgba(0,0,0,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.04) 1px, transparent 1px); background-size: 60px 60px;"
  ></div>

  <div class="relative max-w-[72ch]">
    <span
      class="text-[0.65rem] font-bold tracking-[0.25em] text-[#888] uppercase"
      style="font-family: 'Syne', sans-serif;"
    >
      {eyebrow}
    </span>
    <h1
      class="text-[clamp(2.4rem,5vw,4.2rem)] font-extrabold leading-[1.05] tracking-tight text-[#0a0a0a] mt-4"
      style="font-family: 'Syne', sans-serif;"
    >
      {title}
    </h1>
    <p class="text-[1.05rem] leading-relaxed text-[#555] mt-6 max-w-[62ch]">
      {lede}
    </p>
  </div>
</section>

<section class="relative bg-[#f5f3ee] px-6 md:px-24 pb-20">
  <div class="relative border-t-2 border-[#111] pt-8 mb-10">
    <span
      class="text-[0.65rem] font-bold tracking-[0.25em] text-[#888] uppercase"
      style="font-family: 'Syne', sans-serif;"
    >
      What you get
    </span>
  </div>
  <div class="relative grid gap-px bg-[#d0cdc7] border border-[#d0cdc7]">
    {
      deliverables.map((d, i) => (
        <div class="bg-[#f5f3ee] p-6 md:p-8 grid gap-2 md:grid-cols-[3rem_1fr] md:gap-8">
          <span
            class="text-[0.7rem] font-bold tracking-widest text-[#bbb] pt-1"
            style="font-family: 'Syne', monospace;"
          >
            {String(i + 1).padStart(2, "0")}
          </span>
          <div>
            <h3
              class="text-[1.15rem] font-bold tracking-tight text-[#0a0a0a]"
              style="font-family: 'Syne', sans-serif;"
            >
              {d.title}
            </h3>
            <p class="text-[0.95rem] leading-relaxed text-[#555] mt-2 max-w-[62ch]">
              {d.text}
            </p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<section class="relative bg-[#0a0a0a] px-6 md:px-24 py-20">
  <div class="relative border-t-2 border-[#f5f3ee] pt-8 mb-10">
    <span
      class="text-[0.65rem] font-bold tracking-[0.25em] text-[#888] uppercase"
      style="font-family: 'Syne', sans-serif;"
    >
      What we don't claim
    </span>
  </div>
  <ul class="relative flex flex-col gap-4 max-w-[68ch]">
    {
      honesty.map((h) => (
        <li class="flex gap-3 text-[0.95rem] leading-relaxed text-[#999]">
          <span class="text-red-500 font-bold shrink-0">×</span>
          <span>{h}</span>
        </li>
      ))
    }
  </ul>
  <p class="relative text-[0.85rem] leading-relaxed text-[#666] mt-8 max-w-[68ch]">
    Stated plainly because a pilot built on overclaims fails in week two.
    Everything above is either already validated retrospectively in the
    publication or explicitly labeled exploratory.
  </p>
</section>

<section class="relative bg-[#f5f3ee] px-6 md:px-24 py-20">
  <div class="relative border-t-2 border-[#111] pt-8 mb-6">
    <span
      class="text-[0.65rem] font-bold tracking-[0.25em] text-[#888] uppercase"
      style="font-family: 'Syne', sans-serif;"
    >
      The 4-week pilot
    </span>
    <p class="text-[1rem] leading-relaxed text-[#555] mt-4 max-w-[62ch]">
      {pilotIntro}
    </p>
  </div>
  <div class="relative flex flex-col">
    {
      pilot.map((w, i) => (
        <div
          class={`relative grid gap-4 md:gap-8 py-6 border-b border-[#d0cdc7] ${i === 0 ? "border-t border-[#d0cdc7]" : ""}`}
          style="grid-template-columns: 3rem 1fr;"
        >
          <span
            class="text-[0.7rem] font-bold tracking-widest text-[#bbb] pt-1"
            style="font-family: 'Syne', monospace;"
          >
            {w.week}
          </span>
          <div>
            <h3
              class="text-[1.05rem] font-bold tracking-tight text-[#0a0a0a]"
              style="font-family: 'Syne', sans-serif;"
            >
              {w.title}
            </h3>
            <p class="text-[0.9rem] leading-[1.75] text-[#555] mt-1 max-w-[62ch]">
              {w.text}
            </p>
          </div>
        </div>
      ))
    }
  </div>
  {
    resourcesNote && (
      <p class="relative text-[0.85rem] leading-relaxed text-[#888] mt-8 max-w-[68ch]">
        {resourcesNote}
      </p>
    )
  }
</section>
